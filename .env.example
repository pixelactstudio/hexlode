VITE_APP_TITLE=Hexlode

# Dormant until cloud mode (ADR 0006). On Dokploy, the Postgres service's internal connection URL.
DATABASE_URL=postgresql://user:password@localhost:5432/hexlode

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public values: the server reads them at runtime and hands them to the browser. No secrets here.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
